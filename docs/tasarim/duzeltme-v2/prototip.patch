@@ -0,0 +1,26 @@
+import { View, Text, StyleSheet } from "react-native";
+import { DesignPressable } from "./design-pressable";
+import { GameIcon } from "./icons";
+import { useI18n } from "./i18n";
+import { C, F } from "./theme";
+
+const LEFT = [{ name: "karakter", key: "tab.character", icon: "karakter" }, { name: "sehir", key: "visual.navCity", icon: "sehir" }];
+const RIGHT = [{ name: "iliskiler", key: "visual.navPeople", icon: "iliskiler" }, { name: "tarih", key: "visual.navJournal", icon: "book" }];
+// Önizleme ve oyun aynı alt menü bileşenini kullanır. Orta boşluk ay düğmesinindir.
+export function GameNavigation({ active, onSelect, bottom = 0 }: { active: string; onSelect: (name: string) => void; bottom?: number }) {
+  const { t } = useI18n();
+  const group = (items: typeof LEFT) => <View style={styles.group}>{items.map(item => <DesignPressable key={item.name} accessibilityRole="tab" accessibilityState={{ selected: active === item.name }} accessibilityLabel={t(item.key)} onPress={() => onSelect(item.name)} style={styles.item}>
+    <GameIcon name={item.icon} size={28} color={active === item.name ? C.goldSoft : C.parchmentDim} />
+    <Text style={{ fontFamily: F.serif, fontSize: 14, lineHeight: 17, color: active === item.name ? C.goldSoft : C.parchmentDim, textAlign: "center", maxWidth: "100%" }}>{t(item.key)}</Text>
+  </DesignPressable>)}</View>;
+  return <View style={{ backgroundColor: C.bg, paddingBottom: bottom, paddingHorizontal: 8 }}>
+    <View style={styles.frame}><View pointerEvents="none" style={styles.inner} /><View style={styles.row}>{group(LEFT)}<View style={{ width: 78 }} />{group(RIGHT)}</View></View>
+  </View>;
+}
+const styles = StyleSheet.create({
+  frame: { minHeight: 82, borderWidth: 1, borderColor: C.goldDim, borderRadius: 3, backgroundColor: C.surface, paddingHorizontal: 5, paddingVertical: 5 },
+  inner: { position: "absolute", top: 3, left: 3, right: 3, bottom: 3, borderWidth: 1, borderColor: C.gold + "33", borderRadius: 2 },
+  row: { flexDirection: "row", alignItems: "center" },
+  group: { flex: 1, minWidth: 0, flexDirection: "row" },
+  item: { flex: 1, minWidth: 0, minHeight: 68, alignItems: "center", justifyContent: "center", gap: 4, paddingHorizontal: 1 },
+});
